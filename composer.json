{
    "name": "italix/media",
    "description": "Media conversion drivers for italix/converters — images today, on GD: resize and re-encode, PDF pages to images, trimming to content, cutting a sheet into its cells and merging cells into one; audio and video planned",
    "type": "library",
    "license": "MPL-2.0",
    "version": "2.3.1",
    "keywords": [
        "conversion",
        "image",
        "raster",
        "gd",
        "webp",
        "pdf",
        "ghostscript"
    ],
    "homepage": "https://github.com/italix-net/media",
    "authors": [
        {
            "name": "Italix",
            "email": "info@italix.net"
        }
    ],
    "require": {
        "php": ">=8.1",
        "italix/converters": "^0.7"
    },
    "suggest": {
        "ext-gd": "Required by GdImageConverter, ImageTrimmer, ImageExtractor and ImageGridMerger; without it, all four report unavailable"
    },
    "require-dev": {
        "italix/testing": "^2.0",
        "italix/documents": "^0.16",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Italix\\Media\\": ""
        }
    },
    "scripts": {
        "test": [
            "php tests/GdImageConverterTest.php",
            "php tests/PdfPageToImageConverterTest.php",
            "php tests/ImageTrimmerTest.php",
            "php tests/ImageExtractorTest.php",
            "php tests/ImageGridMergerTest.php",
            "php tests/CookbookTest.php",
            "php tests/ConvertersCookbookTest.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
